<Window x:Class="NetStucked.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:NetStucked.Desktop.ViewModels" xmlns:views="clr-namespace:NetStucked.Desktop.Views" Title="NetStucked" Width="1536" Height="1024" MinWidth="1100" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource CanvasBrush}" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="6"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WindowDot" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" Stroke="#22000000" StrokeThickness="0.7"/><ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ActivityDot" TargetType="Ellipse"><Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/><Setter Property="Fill" Value="#00A369"/><Setter Property="Margin" Value="9,0,0,0"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00D88B" BlurRadius="7" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Style>
<DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><Border Style="{StaticResource Card}" VerticalAlignment="Top"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="8"/></Border></DataTemplate></Window.Resources>
  <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="1" Grid.RowSpan="2" Background="#FCFDFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,24,14,16">
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{StaticResource BorderBrush}" Margin="10,12,10,12"/>
<RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter=Settings, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings" x:Name="SettingsNavigation"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Settings"/></StackPanel></RadioButton>
          <RadioButton x:Name="UpdatesNavigation" Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter=Updates, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Updates"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Updates"/></StackPanel></RadioButton>
          <TextBlock Text="{Binding Version, StringFormat={}v{0}}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,16,0,0"/>
        </StackPanel>
        <StackPanel><StackPanel Orientation="Horizontal" Margin="10,0,0,26"><Canvas Width="22" Height="23" Margin="0,0,8,0"><Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Data="M 11,7 L 11,12 M 4,17 L 4,12 L 18,12 L 18,17"/><Ellipse Width="5" Height="5" Canvas.Left="8.5" Canvas.Top="2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/><Ellipse Width="5" Height="5" Canvas.Left="1.5" Canvas.Top="17" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/><Ellipse Width="5" Height="5" Canvas.Left="15.5" Canvas.Top="17" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/></Canvas><TextBlock Text="NetStucked" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter=Dashboard, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Dashboard"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Live Ping', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Live Ping"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Live Ping"/><Ellipse ToolTip="Live Ping is running"><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource ActivityDot}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPingActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter=Traceroute, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Traceroute"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Traceroute"/><Ellipse ToolTip="A traceroute session is running"><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource ActivityDot}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTraceActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Port Test', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Port Test"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Port Test"/><Ellipse ToolTip="Port Test is running"><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource ActivityDot}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPortActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Network Info', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Network Info"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,16,0"/><TextBlock Text="Network Info"/></StackPanel></RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.ColumnSpan="2" Background="#EDF2F9" BorderBrush="#CBD8E9" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <DockPanel Margin="12,0,10,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Background="#FFBD44" Style="{StaticResource WindowDot}" Click="Minimize_Click" AutomationProperties.Name="Minimize window"/><Button Content="+" Background="#00C84B" Style="{StaticResource WindowDot}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore window"/><Button Content="×" Background="#FF5F57" Style="{StaticResource WindowDot}" Click="Close_Click" AutomationProperties.Name="Close NetStucked"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NetStucked" FontSize="11" Foreground="#607491" Margin="0,0,18,0"/><Border Background="#FCFDFF" BorderBrush="#D1DDED" BorderThickness="1" CornerRadius="4,4,0,0" Padding="14,5" Margin="0,3,0,0"><TextBlock Text="{Binding PageTitle}" FontSize="11"/></Border></StackPanel></DockPanel>
    </Border>
    <StackPanel Grid.Column="1" Grid.Row="1" Margin="16,10,0,0"><TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
    <AdornerDecorator Grid.Column="1" Grid.Row="2" Margin="10,0,12,14"><Grid>
      <views:LivePingView x:Name="PingSurface" DataContext="{Binding Ping}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='Live Ping'}"/>
      <views:TracerouteWorkspaceView x:Name="TraceSurface" DataContext="{Binding TraceWorkspace}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=Traceroute}"/>
      <views:PortTestView x:Name="PortSurface" DataContext="{Binding Port}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='Port Test'}"/>
      <views:UpdatesView x:Name="UpdatesSurface" DataContext="{Binding Updates}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=Updates}"/>
      <ContentControl Content="{Binding CurrentPage}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Other}"/>
    </Grid></AdornerDecorator>
  </Grid></Border>
</Window>
