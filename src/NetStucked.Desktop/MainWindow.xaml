<Window x:Class="NetStucked.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:NetStucked.Desktop.ViewModels" xmlns:views="clr-namespace:NetStucked.Desktop.Views" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" xmlns:s="clr-namespace:NetStucked.Desktop.Services" Title="NetStucked" Width="1536" Height="1024" MinWidth="1100" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource CanvasBrush}" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="6"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WindowDot" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" Stroke="#22000000" StrokeThickness="0.7"/><ContentPresenter x:Name="Glyph" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ActivityDot" TargetType="Ellipse"><Setter Property="Width" Value="7"/><Setter Property="Height" Value="7"/><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/><Setter Property="Margin" Value="9,0,0,0"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00D88B" BlurRadius="7" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Style>
<DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><Border Style="{StaticResource Card}" VerticalAlignment="Top"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="8"/></Border></DataTemplate><DataTemplate DataType="{x:Type vm:AppearanceViewModel}"><views:SettingsView/></DataTemplate>
<Style x:Key="CompactNav" TargetType="RadioButton" BasedOn="{StaticResource Nav}"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,1"/></Style>
<Style x:Key="NavigationSection" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="9,9,0,4"/><Setter Property="Visibility" Value="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/></Style>
<Style x:Key="NavigationLabel" TargetType="TextBlock"><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="Visibility" Value="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/></Style></Window.Resources>
  <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"><Grid b:SlideTrack.IsExpanded="{Binding SidebarExpanded}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="8,16,8,12">
        <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,8"/><TextBlock Text="DATA &amp; APPLICATION" Style="{StaticResource NavigationSection}"/><RadioButton x:Name="SettingsNavigation" Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Settings" AutomationProperties.Name="Settings" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Settings', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="settings" Width="16" Height="16"/><TextBlock Text="Settings" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton x:Name="UpdatesNavigation" Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Updates" AutomationProperties.Name="Updates" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Updates', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Updates" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="refresh-cw" Width="16" Height="16"/><TextBlock Text="Updates" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><TextBlock Text="{Binding Version, StringFormat={}v{0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="14,9,0,0" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"/></StackPanel>
        <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="6,0,0,12"><Image Source="{x:Static s:BrandAssets.Mark}" Width="32" Height="30"/><TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"><Run Text="Net" Foreground="{DynamicResource AccentBrush}"/><Run Text="Stucked"/></TextBlock></StackPanel><Button Command="{Binding ToggleSidebarCommand}" AutomationProperties.Name="Toggle slide bar: main menu" Margin="5,0,5,4" Padding="6"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="panel-left-close" Width="16" Height="16"/><TextBlock Text="Menu" Style="{StaticResource NavigationLabel}"/></StackPanel></Button></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="WORKSPACE" Style="{StaticResource NavigationSection}"/><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Dashboard" AutomationProperties.Name="Dashboard" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Dashboard', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="layout-dashboard" Width="16" Height="16"/><TextBlock Text="Dashboard" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Live Ping" AutomationProperties.Name="Live Ping" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Live Ping', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Live Ping" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="activity" Width="16" Height="16"/><TextBlock Text="Live Ping" Style="{StaticResource NavigationLabel}"/><Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="8,0,0,0" Visibility="{Binding IsPingActive, Converter={StaticResource BoolVisibility}}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Traceroute" AutomationProperties.Name="Traceroute" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Traceroute', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Traceroute" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="route" Width="16" Height="16"/><TextBlock Text="Traceroute" Style="{StaticResource NavigationLabel}"/><Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="8,0,0,0" Visibility="{Binding IsTraceActive, Converter={StaticResource BoolVisibility}}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Diagnostics" AutomationProperties.Name="Diagnostics" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Diagnostics', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="wrench" Width="16" Height="16"/><TextBlock Text="Diagnostics" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Port Test" AutomationProperties.Name="Port Test" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Port Test', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Port Test" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="plug" Width="16" Height="16"/><TextBlock Text="Port Test" Style="{StaticResource NavigationLabel}"/><Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="8,0,0,0" Visibility="{Binding IsPortActive, Converter={StaticResource BoolVisibility}}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="DNS Test" AutomationProperties.Name="DNS Test" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='DNS Test', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="DNS Test" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="globe" Width="16" Height="16"/><TextBlock Text="DNS Test" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="HTTP / HTTPS Test" AutomationProperties.Name="HTTP / HTTPS Test" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='HTTP / HTTPS Test', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="HTTP / HTTPS Test" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="globe" Width="16" Height="16"/><TextBlock Text="HTTP / HTTPS Test" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Network Info" AutomationProperties.Name="Network Info" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Network Info', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Network Info" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="monitor" Width="16" Height="16"/><TextBlock Text="Network Info" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><TextBlock Text="NETWORK OPERATIONS" Style="{StaticResource NavigationSection}"/><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Monitoring" AutomationProperties.Name="Monitoring" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Monitoring', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Monitoring" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="chart-no-axes-combined" Width="16" Height="16"/><TextBlock Text="Monitoring" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Terminal" AutomationProperties.Name="Terminal" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Terminal', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Terminal" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="square-terminal" Width="16" Height="16"/><TextBlock Text="Terminal" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Config Collector" AutomationProperties.Name="Config Collector" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Config Collector', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Config Collector" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="download" Width="16" Height="16"/><TextBlock Text="Config Collector" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="Topology Explorer" AutomationProperties.Name="Topology Explorer" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='Topology Explorer', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Topology Explorer" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="network" Width="16" Height="16"/><TextBlock Text="Topology Explorer" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><TextBlock Text="ASSET &amp; SECURITY" Style="{StaticResource NavigationSection}"/><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="MA Inventory" AutomationProperties.Name="MA Inventory" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='MA Inventory', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="MA Inventory" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="server" Width="16" Height="16"/><TextBlock Text="MA Inventory" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton><RadioButton  Style="{StaticResource CompactNav}" GroupName="Navigation" ToolTip="CVE &amp; Upgrade Planner" AutomationProperties.Name="CVE &amp; Upgrade Planner" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelected}, ConverterParameter='CVE &amp; Upgrade Planner', Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="CVE &amp; Upgrade Planner" Margin="0"><StackPanel Orientation="Horizontal"><b:NavigationIcon IconName="shield-check" Width="16" Height="16"/><TextBlock Text="CVE &amp; Upgrade Planner" Style="{StaticResource NavigationLabel}"/></StackPanel></RadioButton></StackPanel></ScrollViewer></DockPanel>
    </Border>
    <Border Grid.ColumnSpan="2" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <DockPanel Margin="12,0,10,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Background="#FFBD44" Style="{StaticResource WindowDot}" Click="Minimize_Click" AutomationProperties.Name="Minimize window"/><Button Content="+" Background="#00C84B" Style="{StaticResource WindowDot}" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore window"/><Button Content="×" Background="#FF5F57" Style="{StaticResource WindowDot}" Click="Close_Click" AutomationProperties.Name="Close NetStucked"/></StackPanel><Grid Background="Transparent"/></DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Grid.Row="1" Margin="16,10,14,0"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Appearance.Themes}" SelectedItem="{Binding Appearance.SelectedTheme}" Width="95" VerticalAlignment="Center" AutomationProperties.Name="Theme"/><Button DockPanel.Dock="Right" Content="Network changed" Command="{Binding NavigateCommand}" CommandParameter="Network Info" ToolTip="{Binding NetworkTransition}" Visibility="{Binding HasNetworkTransition, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Padding="8,5" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel>
    <AdornerDecorator Grid.Column="1" Grid.Row="2" Margin="10,0,12,14"><Grid>
      <views:LivePingView x:Name="PingSurface" DataContext="{Binding Ping}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='Live Ping'}"/>
      <views:TracerouteWorkspaceView x:Name="TraceSurface" DataContext="{Binding TraceWorkspace}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=Traceroute}"/>
      <views:PortTestView x:Name="PortSurface" DataContext="{Binding Port}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='Port Test'}"/>
      <views:DnsTestView x:Name="DnsSurface" DataContext="{Binding Dns}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='DNS Test'}"/>
      <views:HttpTestView x:Name="HttpSurface" DataContext="{Binding Http}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='HTTP / HTTPS Test'}"/>
      <views:NetworkInfoView x:Name="NetworkSurface" DataContext="{Binding Network}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter='Network Info'}"/>
      <views:UpdatesView x:Name="UpdatesSurface" DataContext="{Binding Updates}" Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisibility}, ConverterParameter=Updates}"/>
      <ContentControl Content="{Binding CurrentPage}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Other}"/>
    </Grid></AdornerDecorator>
  </Grid></Border>
</Window>
