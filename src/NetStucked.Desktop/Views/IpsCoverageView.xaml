<UserControl x:Class="NetStucked.Desktop.Views.IpsCoverageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}" AllowDrop="True" PreviewDragOver="Files_DragOver" Drop="Files_Drop">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10"><TextBlock Text="Signature/catalog coverage only · Found means a signature exists in the checked source; it does not confirm firewall protection or exploit applicability." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding InputSummary}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Style="{StaticResource ResultTabs}">
      <TabItem Header="1  Import &amp; mapping"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Select VA file (.xlsx / .csv)…" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="or drop a file here · source is read-only" VerticalAlignment="Center" Margin="10,0"/><TextBlock Text="{Binding SourceName}" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,10,0,6" IsEnabled="{Binding CanEdit}"><TextBlock Text="Sheet" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" MinWidth="140" Margin="7,0,14,0" AutomationProperties.Name="VA report sheet"/><TextBlock Text="Header row" VerticalAlignment="Center"/><TextBox Text="{Binding HeaderRow, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="7,0" AutomationProperties.Name="VA header row"/><Button Content="Preview header" Command="{Binding PreviewMappingCommand}"/></WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
          <StackPanel Width="200" Margin="0,0,8,6"><TextBlock Text="CVE *"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding CveSelection}" AutomationProperties.Name="CVE column mapping"/></StackPanel>
          <StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="IP Address"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding AddressSelection}" AutomationProperties.Name="IP column mapping"/></StackPanel>
          <StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="Hostname"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding HostnameSelection}" AutomationProperties.Name="Hostname column mapping"/></StackPanel>
          <StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="Plugin / ID"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding PluginSelection}" AutomationProperties.Name="Plugin ID column mapping"/></StackPanel>
          <StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="Plugin name"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding PluginNameSelection}" AutomationProperties.Name="Plugin name column mapping"/></StackPanel>
          <StackPanel Width="140" Margin="0,0,8,6"><TextBlock Text="Severity"/><ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedItem="{Binding SeveritySelection}" AutomationProperties.Name="Severity column mapping"/></StackPanel>
        </WrapPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Preview}" AutoGenerateColumns="True" IsReadOnly="True" b:ResultZoom.Enabled="True" AutomationProperties.Name="VA preview first 100 rows"/>
        <StackPanel Grid.Row="4" Margin="0,8,0,0"><WrapPanel><Button Content="Confirm mapping → Sources" Command="{Binding ConfirmMappingCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Preview shows first 100 rows. All imported values and original row numbers are retained." VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/></WrapPanel><Expander Header="Import issues (empty / invalid CVE)" Margin="0,8,0,0"><DataGrid ItemsSource="{Binding ImportIssues}" MaxHeight="140" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.Name="Import issues"/></Expander></StackPanel>
      </Grid></TabItem>
      <TabItem Header="2  Sources"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="10" IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Palo Alto · Threat Vault API" Style="{StaticResource Heading}"/><CheckBox Content="Use Palo Alto" IsChecked="{Binding UsePaloAlto}" Margin="0,8"/><TextBlock Text="{Binding PaloAltoStatus}" TextWrapping="Wrap"/><TextBlock Text="API key · save explicitly to Windows Credential Manager" TextWrapping="Wrap" Margin="0,12,0,5"/><PasswordBox x:Name="ApiKey" AutomationProperties.Name="Threat Vault API key" MaxLength="2048"/><WrapPanel Margin="0,8"><Button Content="Save key securely" Click="SaveKey_Click"/><Button Content="Remove saved key" Command="{Binding RemoveKeyCommand}" Margin="6,0"/><Button Content="Test connection" Command="{Binding TestConnectionCommand}"/></WrapPanel><TextBlock Text="Only CVE IDs are sent. IPs, hostnames and the VA file stay local. Vulnerability Protection signatures count as IPS; Antivirus is displayed separately." TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="200 requests/minute and 2,000/day provider limits; retries are bounded. Errors and missing permissions remain Unknown." TextWrapping="Wrap" Style="{StaticResource Muted}"/><Button Content="Threat Vault setup documentation ↗" Click="PaloDocs_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Check Point · SmartConsole IPS CSV" Style="{StaticResource Heading}"/><CheckBox Content="Use Check Point snapshot" IsChecked="{Binding UseCheckPoint}" Margin="0,8"/><Button Content="Import IPS Protections CSV…" Command="{Binding ImportSnapshotCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding SnapshotStatus}" TextWrapping="Wrap" Margin="0,8"/><WrapPanel><TextBlock Text="Header row" VerticalAlignment="Center"/><TextBox Text="{Binding SnapshotHeaderRow, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0" AutomationProperties.Name="Snapshot header row"/><Button Content="Preview header" Command="{Binding PreviewSnapshotMappingCommand}"/></WrapPanel>
          <TextBlock Text="Industry Reference / CVE *" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding SnapshotColumns}" DisplayMemberPath="Label" SelectedItem="{Binding SnapshotCveSelection}" AutomationProperties.Name="Check Point CVE mapping"/>
          <TextBlock Text="Protection name *" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding SnapshotColumns}" DisplayMemberPath="Label" SelectedItem="{Binding SnapshotNameSelection}" AutomationProperties.Name="Check Point protection name mapping"/>
          <TextBlock Text="Protection ID (optional)" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding SnapshotColumns}" DisplayMemberPath="Label" SelectedItem="{Binding SnapshotIdSelection}" AutomationProperties.Name="Check Point protection ID mapping"/>
          <TextBlock Text="Profile action (optional · snapshot only)" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding SnapshotColumns}" DisplayMemberPath="Label" SelectedItem="{Binding SnapshotActionSelection}" AutomationProperties.Name="Check Point snapshot action mapping"/>
          <TextBlock Text="Package / version (optional, user supplied)" Margin="0,8,0,0"/><TextBox Text="{Binding SnapshotPackage, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Source date (yyyy-MM-dd · optional, user supplied)" Margin="0,6,0,0"/><TextBox Text="{Binding SnapshotDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
          <Button Content="Apply snapshot" Command="{Binding ApplySnapshotCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,6"/><TextBlock Text="Only the imported CSV is searched. No Management Server connection. Missing Protection ID is allowed; Prevent/Detect/Inactive never proves current enforcement." TextWrapping="Wrap" Style="{StaticResource Muted}"/><Button Content="SmartConsole export documentation ↗" Click="CheckPointDocs_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="3  Coverage results"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="120"/><RowDefinition Height="6"/><RowDefinition Height="*" MinHeight="120"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Check coverage" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Refresh (bypass cache)" Command="{Binding RefreshCommand}" Margin="6,0"/><Button Content="Retry failed / unchecked" Command="{Binding RetryFailedCommand}"/><TextBlock Text="Unknown is included in totals. Vendor percentages are never combined." VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/></WrapPanel>
        <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Palo Alto" FontWeight="SemiBold"/><TextBlock Text="{Binding PaloSummary}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Check Point" FontWeight="SemiBold"/><TextBlock Text="{Binding CheckPointSummary}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8"><ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding GroupBy}" Width="130" AutomationProperties.Name="Group coverage results"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="230" Margin="8,0" AutomationProperties.Name="Filter coverage results"/><TextBlock Text="Select a CVE for evidence · group counts use unique CVE" VerticalAlignment="Center" Style="{StaticResource Muted}"/></WrapPanel>
        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DataGrid ItemsSource="{Binding GroupRows}" SelectedItem="{Binding SelectedGroup}" Visibility="{Binding IsGroupView, Converter={StaticResource BoolVisibility}}" MaxHeight="160" IsReadOnly="True" AutomationProperties.Name="Plugin or asset coverage"><DataGrid.Columns><b:CopyableTextColumn Header="Plugin / asset" Binding="{Binding Name}" Width="180"/><b:CopyableTextColumn Header="Source rows" Binding="{Binding SourceRows}" Width="120"/><b:CopyableTextColumn Header="Unique CVE" Binding="{Binding CveCount}" Width="100"/><b:CopyableTextColumn Header="Palo Alto (whole group)" Binding="{Binding PaloAlto}" Width="300"/><b:CopyableTextColumn Header="Check Point (whole group)" Binding="{Binding CheckPoint}" Width="300"/></DataGrid.Columns></DataGrid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ResultRows}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True" b:ResultZoom.Enabled="True" AutomationProperties.Name="CVE IPS coverage results"><DataGrid.Columns><b:CopyableTextColumn Header="CVE" Binding="{Binding Cve}" Width="165"/><b:CopyableTextColumn Header="Palo Alto · IPS" Binding="{Binding PaloStatus}" Width="190"/><b:CopyableTextColumn Header="Check Point · IPS" Binding="{Binding CheckPointStatus}" Width="190"/><b:CopyableTextColumn Header="Source rows" Binding="{Binding SourceRows}" Width="120"/><b:CopyableTextColumn Header="Freshness / cache" Binding="{Binding Freshness}" Width="*" MinWidth="220"/></DataGrid.Columns></DataGrid>
        </Grid>
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
        <TabControl Grid.Row="5" Style="{StaticResource ResultTabs}"><TabItem Header="Evidence"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5"><Button Content="Palo Alto catalog search ↗" Click="PaloSearch_Click"/><Button Content="Check Point advisory search ↗" Click="CheckPointAdvisories_Click" Margin="6,0"/><TextBlock Text="Manual review · not an automatic online Check Point check" VerticalAlignment="Center" Style="{StaticResource Muted}"/></WrapPanel><TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" b:ResultZoom.Enabled="True" AutomationProperties.Name="Coverage evidence"/></DockPanel></TabItem><TabItem Header="Original source rows"><DataGrid ItemsSource="{Binding SelectedSourceRows}" AutoGenerateColumns="True" IsReadOnly="True" b:ResultZoom.Enabled="True" AutomationProperties.Name="Selected CVE original source rows"/></TabItem><TabItem Header="Signatures (Antivirus separate)"><DataGrid ItemsSource="{Binding Signatures}" IsReadOnly="True" AutomationProperties.Name="IPS signature details"><DataGrid.Columns><b:CopyableTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="110"/><b:CopyableTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="130"/><b:CopyableTextColumn Header="ID" Binding="{Binding Id}" Width="100"/><b:CopyableTextColumn Header="Name" Binding="{Binding Name}" Width="250"/><b:CopyableTextColumn Header="Type" Binding="{Binding Type}" Width="180"/><b:CopyableTextColumn Header="Status" Binding="{Binding Status}" Width="120"/><b:CopyableTextColumn Header="Content version" Binding="{Binding ContentVersion}" Width="120"/><b:CopyableTextColumn Header="Release" Binding="{Binding Release}" Width="220"/><b:CopyableTextColumn Header="Limitations / references" Binding="{Binding Limitations}" Width="300"/><b:CopyableTextColumn Header="Snapshot action only" Binding="{Binding SnapshotAction}" Width="160"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
      </Grid></TabItem>
      <TabItem Header="4  Export"><StackPanel Margin="14" MaxWidth="1000" HorizontalAlignment="Left"><TextBlock Text="Export a new Excel workbook" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" Margin="0,12"/><CheckBox Content="Export partial results — I acknowledge that unchecked CVE are not completed results" IsChecked="{Binding AcknowledgePartial}" Margin="0,5,0,12"/><Button Content="Export Excel…" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="Original files are never overwritten. All text is stored as text, including strings starting with =, +, - or @. Filters, frozen headers and wrapped Thai/long text are included." TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,8,0,0"><DockPanel><Button Content="Cancel" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap"/><ProgressBar Value="{Binding CompletedJobs}" Maximum="{Binding TotalJobs}" Height="5" Width="140" Margin="10,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></DockPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  </Grid>
</UserControl>
