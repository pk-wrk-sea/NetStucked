<UserControl x:Class="NetStucked.Desktop.Views.TracerouteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" xmlns:views="clr-namespace:NetStucked.Desktop.Views" Style="{StaticResource {x:Type UserControl}}">
  <Grid b:SlideTrack.Index="2" b:SlideTrack.IsExpanded="{Binding EventsExpanded}"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="3*" MinWidth="64"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Traceroute Target" Style="{StaticResource Heading}" Margin="3,2,0,12"/>
        <Grid b:SlideTrack.Index="2" b:SlideTrack.IsExpanded="{Binding EventsExpanded}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="3,0,10,0"><Label Content="Target (IP / Hostname)" Target="{Binding ElementName=TargetBox}" Padding="0,0,0,4" Foreground="{DynamicResource MutedBrush}"/><ComboBox b:Watermark.Text="Input Host or IP" x:Name="TargetBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Value" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentAddresses}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Traceroute destination IP or hostname"><ComboBox.ItemTemplate><DataTemplate><DockPanel MinWidth="220"><Button DockPanel.Dock="Right" Content="×" Command="{Binding DeleteCommand}" Padding="4,0" Width="24" MinHeight="22" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Delete destination history"/><TextBlock Text="{Binding Value}" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          <Button Grid.Column="1" Content="&#xE713;" Style="{StaticResource IconButton}" AutomationProperties.Name="Probe Settings" Command="{Binding SettingsCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="8,7"/><Button Grid.Column="2" Content="▶ Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/><Button Grid.Column="3" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="8,7"/><Button Grid.Column="4" Content="● Stop" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" VerticalAlignment="Bottom"/>
        </Grid><TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="3,8,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hop Description" Command="{Binding DataContext.HopDescriptionsCommand, RelativeSource={RelativeSource AncestorType={x:Type views:TracerouteWorkspaceView}}}" AutomationProperties.Name="Edit shared hop descriptions" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="115" Margin="0,0,8,0" AutomationProperties.Name="Traceroute status filter"/><Button Content="&#xE9D9;" Style="{StaticResource IconButton}" IsEnabled="False" AutomationProperties.Name="Chart unavailable in 0.1.0" Margin="0,0,8,0"/><Button Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitResults_Click" AutomationProperties.Name="Fit Columns" Margin="0,0,8,0"/><Button Content="&#xE80A;" Style="{StaticResource IconButton}" Click="Columns_Click" AutomationProperties.Name="Configure traceroute columns" Margin="0,0,8,0"/><Button Content="&#xE896;" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="Export traceroute results to CSV"/></StackPanel><TextBlock Text="Traceroute Results" Style="{StaticResource Heading}"/></DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" RowStyle="{StaticResource StatusRow}" b:ColumnLayout.Store="{Binding Store}" b:ColumnLayout.Key="Trace" ColumnHeaderHeight="42" FrozenColumnCount="1" IsReadOnly="False" AutomationProperties.Name="Traceroute Results">
          <DataGrid.Columns>
            <b:CopyableTextColumn Header="Hop" Binding="{Binding Hop}" Width="45" IsReadOnly="True"/><b:CopyableTextColumn Header="Address" Binding="{Binding Address, TargetNullValue=*}" Width="112" IsReadOnly="True"/><b:CopyableTextColumn Header="Hostname" Binding="{Binding Hostname, TargetNullValue=—}" Width="130" IsReadOnly="True"/><b:CopyableTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="125" EditingElementStyle="{StaticResource {x:Type TextBox}}"/>
            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="100" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource TableText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <b:CopyableTextColumn Header="TCP open ports" Binding="{Binding TcpOpenPorts}" Width="130" IsReadOnly="True"><b:CopyableTextColumn.ElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource TableText}"><Setter Property="ToolTip" Value="{Binding TcpCheckDetails}"/></Style></b:CopyableTextColumn.ElementStyle></b:CopyableTextColumn><b:CopyableTextColumn Header="Last (ms)" Binding="{Binding Last, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><b:CopyableTextColumn Header="Best (ms)" Binding="{Binding Best, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><b:CopyableTextColumn Header="Avg (ms)" Binding="{Binding Average, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><b:CopyableTextColumn Header="Worst (ms)" Binding="{Binding Worst, StringFormat=0.##, TargetNullValue=—}" Width="80" IsReadOnly="True"/><b:CopyableTextColumn Header="Jitter (ms)" Binding="{Binding Jitter, StringFormat=0.##, TargetNullValue=—}" Width="80" IsReadOnly="True"/>
            <b:CopyableTextColumn Header="Sent" Binding="{Binding Sent}" Width="58" IsReadOnly="True"/><b:CopyableTextColumn Header="Recv" Binding="{Binding Received}" Width="58" IsReadOnly="True"/><b:CopyableTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.0}%}" Width="70" IsReadOnly="True"/><b:CopyableTextColumn Header="Route Changes" Binding="{Binding RouteChanges}" Width="95" IsReadOnly="True"/><b:CopyableTextColumn Header="Updated" Binding="{Binding Updated, StringFormat=HH:mm:ss, TargetNullValue=—}" Width="*" MinWidth="85" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></Border>
    </Grid>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="{Binding EventsExpanded, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Resize trace events panel"/>
    <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="&#xE700;" Style="{StaticResource IconButton}" Command="{Binding ToggleEventsCommand}" AutomationProperties.Name="Toggle slide bar: trace events"/><ComboBox Visibility="{Binding EventsExpanded, Converter={StaticResource BoolVisibility}}" DockPanel.Dock="Right" ItemsSource="{Binding EventFilters}" SelectedItem="{Binding EventFilter}" Width="110" AutomationProperties.Name="Trace Event Log type filter"/><TextBlock Visibility="{Binding EventsExpanded, Converter={StaticResource BoolVisibility}}" Text="Trace Events" Style="{StaticResource Heading}"/></DockPanel>
      <DataGrid Grid.Row="1" Visibility="{Binding EventsExpanded, Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Events}" RowHeight="NaN" MinRowHeight="32" AutomationProperties.Name="Trace Event Log"><DataGrid.Columns><b:CopyableTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="68"/><b:CopyableTextColumn Header="Type" Binding="{Binding Type}" Width="55"><b:CopyableTextColumn.ElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource TableText}"><Setter Property="Foreground" Value="{Binding Type, Converter={StaticResource StatusBrush}}"/></Style></b:CopyableTextColumn.ElementStyle></b:CopyableTextColumn><b:CopyableTextColumn Header="Hop" Binding="{Binding Hop, TargetNullValue=—}" Width="42"/><b:CopyableTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="100"><b:CopyableTextColumn.ElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource TableText}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{Binding Type, Converter={StaticResource StatusBrush}}"/></Style></b:CopyableTextColumn.ElementStyle></b:CopyableTextColumn></DataGrid.Columns></DataGrid>
    </Grid></Border>
  </Grid>
</UserControl>
