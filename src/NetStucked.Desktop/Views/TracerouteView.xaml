<UserControl x:Class="NetStucked.Desktop.Views.TracerouteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="3*" MinWidth="265"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Traceroute Target" Style="{StaticResource Heading}" Margin="3,2,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="3,0,10,0"><Label Content="Target (IP / Hostname)" Target="{Binding ElementName=TargetBox}" Padding="0,0,0,4" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="TargetBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Value" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentAddresses}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Traceroute destination IP or hostname"><ComboBox.ItemTemplate><DataTemplate><DockPanel MinWidth="220"><Button DockPanel.Dock="Right" Content="×" Command="{Binding DeleteCommand}" Padding="4,0" Width="24" MinHeight="22" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Delete destination history"/><TextBlock Text="{Binding Value}" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
          <Button Grid.Column="1" Content="&#xE713;" Style="{StaticResource IconButton}" AutomationProperties.Name="Probe Settings" Command="{Binding SettingsCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="8,7"/><Button Grid.Column="2" Content="▶ Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/><Button Grid.Column="3" Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="8,7"/><Button Grid.Column="4" Content="● Stop" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" VerticalAlignment="Bottom"/>
        </Grid><TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="3,8,0,0" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="115" Margin="0,0,8,0" AutomationProperties.Name="Traceroute status filter"/><Button Content="&#xE9D9;" Style="{StaticResource IconButton}" IsEnabled="False" AutomationProperties.Name="Chart unavailable in 0.1.0" Margin="0,0,8,0"/><Button Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitResults_Click" AutomationProperties.Name="Fit Columns" Margin="0,0,8,0"/><Button Content="&#xE80A;" Style="{StaticResource IconButton}" Click="Columns_Click" AutomationProperties.Name="Configure traceroute columns" Margin="0,0,8,0"/><Button Content="&#xE896;" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="Export traceroute results to CSV"/></StackPanel><TextBlock Text="Traceroute Results" Style="{StaticResource Heading}"/></DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" RowStyle="{StaticResource StatusRow}" b:ColumnLayout.Store="{Binding Store}" b:ColumnLayout.Key="Trace" ColumnHeaderHeight="42" FrozenColumnCount="1" IsReadOnly="False" AutomationProperties.Name="Traceroute Results">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="45" IsReadOnly="True"/><DataGridTextColumn Header="Address" Binding="{Binding Address, TargetNullValue=*}" Width="112" IsReadOnly="True"/><DataGridTextColumn Header="Hostname" Binding="{Binding Hostname, TargetNullValue=—}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="100" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Last (ms)" Binding="{Binding Last, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Best (ms)" Binding="{Binding Best, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Avg (ms)" Binding="{Binding Average, StringFormat=0.##, TargetNullValue=—}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Worst (ms)" Binding="{Binding Worst, StringFormat=0.##, TargetNullValue=—}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="Jitter (ms)" Binding="{Binding Jitter, StringFormat=0.##, TargetNullValue=—}" Width="80" IsReadOnly="True"/>
            <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="58" IsReadOnly="True"/><DataGridTextColumn Header="Recv" Binding="{Binding Received}" Width="58" IsReadOnly="True"/><DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.0}%}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="Route Changes" Binding="{Binding RouteChanges}" Width="95" IsReadOnly="True"/><DataGridTextColumn Header="Updated" Binding="{Binding Updated, StringFormat=HH:mm:ss, TargetNullValue=—}" Width="*" MinWidth="85" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></Border>
    </Grid>
    <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="3,0,3,10"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding EventFilters}" SelectedItem="{Binding EventFilter}" Width="110" AutomationProperties.Name="Trace Event Log type filter"/><TextBlock Text="Trace Event Log" Style="{StaticResource Heading}"/></DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" RowHeight="NaN" MinRowHeight="32" AutomationProperties.Name="Trace Event Log"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="68"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="55"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Type, Converter={StaticResource StatusBrush}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Hop" Binding="{Binding Hop, TargetNullValue=—}" Width="42"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{Binding Type, Converter={StaticResource StatusBrush}}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
    </Grid></Border>
  </Grid>
</UserControl>
