<Window x:Class="NetStucked.Desktop.Views.TerminalKnownHostsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Title="Saved SSH host keys" Width="850" Height="440" MinWidth="600" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="18" Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshHostKeysCommand}"/><TextBlock Text="Saved SSH host keys" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding KnownHosts}" SelectedItem="{Binding SelectedKnownHost}" AutomationProperties.Name="Saved SSH host keys"><DataGrid.Columns><b:CopyableTextColumn Header="Host / Port" Binding="{Binding Endpoint}" Width="170"/><b:CopyableTextColumn Header="Key type" Binding="{Binding Algorithm}" Width="110"/><b:CopyableTextColumn Header="SHA-256 fingerprint" Binding="{Binding Fingerprint}" Width="360"/><b:CopyableTextColumn Header="Accepted at" Binding="{Binding AcceptedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="200"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Removing a saved key asks for confirmation next time you connect. Current connections stay open." TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock Text="{Binding HostKeysMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="80"/><Button Content="Remove selected key" Command="{Binding RemoveHostKeyCommand}" HorizontalAlignment="Left"/></DockPanel></StackPanel>
  </Grid>
</Window>
