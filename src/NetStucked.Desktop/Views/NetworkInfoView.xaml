<UserControl x:Class="NetStucked.Desktop.Views.NetworkInfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <UserControl.Resources>
    <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="InfoValue" TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,8" Background="{DynamicResource SurfaceBrush}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </UserControl.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE8B5;" Style="{StaticResource IconButton}" Command="{Binding ImportCommand}" AutomationProperties.Name="Import Wi-Fi profile XML" Margin="0,0,6,0"/><Button Content="&#xE8B6;" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="Export selected profile without passwords"/></StackPanel>
        <TextBlock Text="Wireless Adapter" Style="{StaticResource InfoLabel}"/>
        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" MinWidth="190" Width="285" IsEnabled="{Binding IsBusy, Converter={x:Static b:BooleanInverter.Instance}}" AutomationProperties.Name="Wireless Adapter" Margin="0,0,12,0"/>
        <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding ScanCommand}" AutomationProperties.Name="Scan SSIDs" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusBrush}}"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Cancel Wi-Fi operation"/>
      </DockPanel>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="46" Margin="4,7,4,7" FontSize="11"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="430"/><ColumnDefinition Width="10"/><ColumnDefinition Width="350" MinWidth="290"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="1.65*" MinHeight="190"/><RowDefinition Height="10"/><RowDefinition Height="*" MinHeight="110"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="10">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6"><TextBox DockPanel.Dock="Right" Width="190" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" b:Watermark.Text="Search profiles…" AutomationProperties.Name="Search Wi-Fi profiles"/><TextBlock Text="{Binding ProfileCount}" Style="{StaticResource Heading}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
            <TabControl Grid.Row="1" IsEnabled="{Binding IsBusy, Converter={x:Static b:BooleanInverter.Instance}}">
              <TabItem Header="Saved Profiles"><DataGrid x:Name="ProfilesGrid" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutomationProperties.Name="Saved Wi-Fi Profiles" SelectionMode="Single" Margin="0,6,0,4" b:ColumnLayout.Key="WifiProfiles" b:ColumnLayout.Store="{Binding Store}"><DataGrid.Columns>
                <b:CopyableTextColumn Header="Profile" Binding="{Binding Name}" Width="150"/>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource TableText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <b:CopyableTextColumn Header="Security" Binding="{Binding Security}" Width="140"/>
                <b:CopyableTextColumn Header="Signal" Binding="{Binding Signal}" Width="65"/>
                <b:CopyableTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="120"/>
                <b:CopyableTextColumn Header="Last used" Binding="{Binding LastUsed}" Width="125"/>
                <b:CopyableTextColumn Header="Mode" Binding="{Binding Auto}" Width="70"/>
              </DataGrid.Columns></DataGrid></TabItem>
              <TabItem Header="Available SSIDs"><DataGrid x:Name="NetworksGrid" ItemsSource="{Binding AvailableNetworks}" SelectedItem="{Binding SelectedNetwork}" AutomationProperties.Name="Available Wi-Fi networks" Margin="0,6,0,4"><DataGrid.Columns><b:CopyableTextColumn Header="SSID" Binding="{Binding Ssid}" Width="*"/><b:CopyableTextColumn Header="Security" Binding="{Binding Security}" Width="150"/><b:CopyableTextColumn Header="Signal (%)" Binding="{Binding Signal}" Width="90"/><DataGridCheckBoxColumn Header="Connectable" Binding="{Binding Connectable}" Width="90"/></DataGrid.Columns></DataGrid></TabItem>
            </TabControl>
            <DockPanel Grid.Row="2" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE8A9;" Style="{StaticResource IconButton}" Click="FitProfiles_Click" AutomationProperties.Name="Fit profile columns"/><Button Content="&#xE713;" Style="{StaticResource IconButton}" Click="Columns_Click" AutomationProperties.Name="Configure profile columns"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="▶ Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Padding="9,6" Margin="0,0,6,0"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="9,6" Margin="0,0,6,0"/><Button Content="&#xE710;" Style="{StaticResource IconButton}" Command="{Binding AddProfileCommand}" AutomationProperties.Name="Add Personal Wi-Fi profile"/><Button Content="&#xE70F;" Style="{StaticResource IconButton}" Command="{Binding EditProfileCommand}" AutomationProperties.Name="Edit description / Windows auto-connect"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" Command="{Binding DeleteProfileCommand}" AutomationProperties.Name="Delete Windows Wi-Fi profile"/></StackPanel></DockPanel>
          </Grid>
        </Border>
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize Wi-Fi profile/history panels"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10"><DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="&#xE9F9;" Style="{StaticResource IconButton}" Command="{Binding ExportHistoryCommand}" AutomationProperties.Name="Export Wi-Fi history CSV"/><TabControl><TabItem Header="Connection History"><DataGrid ItemsSource="{Binding ConnectionHistory}" SelectedItem="{Binding SelectedHistory}" IsEnabled="{Binding IsBusy, Converter={x:Static b:BooleanInverter.Instance}}" AutomationProperties.Name="Wi-Fi connection history" Margin="0,6,0,0"><DataGrid.Columns><b:CopyableTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="112"/><b:CopyableTextColumn Header="Profile" Binding="{Binding Profile}" Width="120"/><b:CopyableTextColumn Header="Event" Binding="{Binding Event}" Width="130"/><b:CopyableTextColumn Header="Result" Binding="{Binding Result}" Width="85"/><b:CopyableTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="150"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Logs"><DataGrid ItemsSource="{Binding Events}" AutomationProperties.Name="Wi-Fi event log" Margin="0,6,0,0"><DataGrid.Columns><b:CopyableTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="112"/><b:CopyableTextColumn Header="Adapter" Binding="{Binding Adapter}" Width="160"/><b:CopyableTextColumn Header="Event" Binding="{Binding Event}" Width="130"/><b:CopyableTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="160"/></DataGrid.Columns></DataGrid></TabItem></TabControl></DockPanel></Border>
      </Grid>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize Wi-Fi details panel"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="Connection Profile Details" Style="{StaticResource Heading}" FontSize="13"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="SSID" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Ssid}" Style="{StaticResource InfoValue}" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Description" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.Description}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="2" Text="Security Type" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.Security}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="3" Text="EAP Method" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Eap}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="4" Text="Management" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.Management}" Style="{StaticResource InfoValue}"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="Secure Credential Management" Style="{StaticResource Heading}" FontSize="13"/><TextBlock Text="{Binding CredentialGuide}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Set Credentials" Command="{Binding CredentialsCommand}" Padding="9,6" Margin="0,0,6,0"/><Button Content="Forget app copy" Command="{Binding ForgetCredentialsCommand}" Padding="9,6" ToolTip="Remove only the NetStucked Credential Manager entry. Windows/EAP may still retain credentials."/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ObservedAt}" Style="{StaticResource Muted}"/><TextBlock Text="Connection Status" Style="{StaticResource Heading}" FontSize="13"/></DockPanel><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Status" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusBrush}}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="1" Text="Connected SSID" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectedSsid}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="2" Text="IPv4 / IPv6" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IpAddresses}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="3" Text="Gateway" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Gateway}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="4" Text="DNS Servers" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DnsServers}" Style="{StaticResource InfoValue}"/><TextBlock Grid.Row="5" Text="Signal Quality" Style="{StaticResource InfoLabel}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Signal}" Style="{StaticResource InfoValue}"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="Connect &amp; Test Services" Style="{StaticResource Heading}" FontSize="13"/><Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding TestProfiles}" SelectedItem="{Binding SelectedTestProfile}" DisplayMemberPath="Name" IsEnabled="{Binding IsBusy, Converter={x:Static b:BooleanInverter.Instance}}" b:Watermark.Text="Company test profile" AutomationProperties.Name="Company service test profile" Margin="0,0,6,0"/><Button Grid.Column="1" Content="&#xE710;" Command="{Binding AddTestProfileCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Add service test profile"/><Button Grid.Column="2" Content="&#xE70F;" Command="{Binding EditTestProfileCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Edit service test profile"/><Button Grid.Column="3" Content="&#xE74D;" Command="{Binding DeleteTestProfileCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Delete service test profile"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Connect &amp; Test" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectAndTestCommand}" Padding="8,6" Margin="0,0,5,0"/><Button Grid.Column="1" Content="Run Tests" Command="{Binding RunTestsCommand}" Padding="8,6" Margin="5,0,0,0"/></Grid><TextBlock Text="{Binding TestSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,8"/><DataGrid ItemsSource="{Binding TestResults}" Height="150" AutomationProperties.Name="Wi-Fi service test results"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGrid.RowStyle><DataGrid.Columns><b:CopyableTextColumn Header="Service" Binding="{Binding Service}" Width="95"/><DataGridTemplateColumn Header="Result" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource TableText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><b:CopyableTextColumn Header="ms" Binding="{Binding LatencyMs, StringFormat=0.0}" Width="52"/><b:CopyableTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="100"/></DataGrid.Columns></DataGrid><Button Content="Export results CSV" Command="{Binding ExportTestsCommand}" HorizontalAlignment="Right" Margin="0,9,0,0" Padding="8,5"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
