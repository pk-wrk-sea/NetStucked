<UserControl x:Class="NetStucked.Desktop.Views.LivePingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Addresses List to Ping" Style="{StaticResource Heading}" FontSize="13"/>
        <Grid Grid.Row="1" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" IsEnabled="{Binding CanEdit}" TextSearch.TextPath="Name" AutomationProperties.Name="Choose address template" ToolTip="Choose a saved address template" Margin="0,0,6,0">
            <ComboBox.ItemTemplate><DataTemplate><DockPanel MinWidth="180"><Button DockPanel.Dock="Right" Content="×" Command="{Binding DeleteCommand}" Padding="4,0" Width="24" MinHeight="22" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Delete address template"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0"/></DockPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="&#xE74E;" Command="{Binding SaveCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Save address template" Margin="0,0,4,0"/>
          <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="Probe Settings"/>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#C7D7EC" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FCFDFF">
          <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000000" IsReadOnly="{Binding CanEdit, Converter={x:Static b:BooleanInverter.Instance}}" AcceptsReturn="True" AcceptsTab="False" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="2,4" Background="Transparent" FontSize="13" AutomationProperties.Name="Addresses List to Ping"/>
        </Border>
        <ScrollViewer Grid.Row="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,6,0,4"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#CE3D3D" FontSize="11"/></ScrollViewer>
        <StackPanel Grid.Row="4" Margin="0,8,0,10"><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/><TextBlock Text="{Binding TargetPreview}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
        <UniformGrid Grid.Row="5" Columns="3"><Button Content="▶  Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,5,0"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Margin="3,0,3,0" Padding="6,7"/><Button Content="●  Stop" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" Margin="5,0,0,0"/></UniformGrid>
      </Grid>
    </Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="10"/><RowDefinition Height="1.2*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <UniformGrid Columns="6" Width="660" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Targets" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TargetCount, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Reachable" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Reachable, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Foreground="#00A36B" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Unreachable" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Unreachable, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Sent" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Sent, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Received" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Received, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8"><StackPanel><TextBlock Text="Loss" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Loss, StringFormat={}{0:0.0}%}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="130" Margin="0,0,10,0" AutomationProperties.Name="Realtime status filter"/><Button Content="&#xE9D9;" Style="{StaticResource IconButton}" IsEnabled="False" AutomationProperties.Name="Chart unavailable in 0.1.0" Margin="0,0,8,0"/><Button Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitResults_Click" AutomationProperties.Name="Fit Columns" Margin="0,0,8,0"/><Button Content="&#xE80A;" Style="{StaticResource IconButton}" Click="Columns_Click" AutomationProperties.Name="Configure realtime columns" Margin="0,0,8,0"/><Button Content="&#xE896;" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="Export realtime results to CSV"/></StackPanel><TextBlock Style="{StaticResource Heading}"><Run Text="Realtime Results "/><Run Text="{Binding TargetCount, StringFormat={}({0} hosts)}" FontSize="12" FontWeight="Normal"/></TextBlock></DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" b:GridTools.UnselectCommand="{Binding UnselectCommand}" RowStyle="{StaticResource StatusRow}" b:ColumnLayout.Store="{Binding Store}" b:ColumnLayout.Key="Ping" FrozenColumnCount="2" AutomationProperties.Name="Realtime Results">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/>
            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="115"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="100"/><DataGridTextColumn Header="Resolved IP" Binding="{Binding ResolvedIp, TargetNullValue=—}" Width="115"/>
            <DataGridTextColumn Header="Last (ms)" Binding="{Binding Last, StringFormat=0.##, TargetNullValue=—}" Width="70"/><DataGridTextColumn Header="Avg (ms)" Binding="{Binding Average, StringFormat=0.##, TargetNullValue=—}" Width="70"/><DataGridTextColumn Header="Min (ms)" Binding="{Binding Minimum, StringFormat=0.##, TargetNullValue=—}" Width="70"/><DataGridTextColumn Header="Max (ms)" Binding="{Binding Maximum, StringFormat=0.##, TargetNullValue=—}" Width="70"/>
            <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="55"/><DataGridTextColumn Header="Recv" Binding="{Binding Received}" Width="55"/><DataGridTextColumn Header="Lost" Binding="{Binding Lost}" Width="55"/><DataGridTextColumn Header="Loss %" Binding="{Binding LossPercent, StringFormat={}{0:0.0}%}" Width="70"/>
            <DataGridTextColumn Header="Last ping" Binding="{Binding LastPing, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccess, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="Reachable since" Binding="{Binding ReachableSince, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="Unreachable since" Binding="{Binding UnreachableSince, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="TTL" Binding="{Binding Ttl, TargetNullValue=—}" Width="60" Visibility="Collapsed"/>
            <DataGridTextColumn Header="Result / error" Binding="{Binding ResultError}" Width="*" MinWidth="200"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></Border>
      <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><Button DockPanel.Dock="Right" Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitHistory_Click" AutomationProperties.Name="Fit History Columns" Margin="8,0,0,0"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding HistoryLimits}" SelectedItem="{Binding HistoryLimit}" Width="110" AutomationProperties.Name="Ping History retention display"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}Last {0}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/></DockPanel>
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History, NotifyOnTargetUpdated=True}" AutomationProperties.Name="Selected target Ping History"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="190"/><DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="55"/><DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs, StringFormat=0.##, TargetNullValue=—}" Width="120"/><DataGridTextColumn Header="TTL" Binding="{Binding Ttl, TargetNullValue=—}" Width="65"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="100"/></DataGrid.Columns></DataGrid>
      </Grid></Border>
    </Grid>
  </Grid>
</UserControl>
