<UserControl x:Class="NetStucked.Desktop.Views.MonitoringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="250"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="New" Command="{Binding NewDeviceCommand}"/><TextBlock Text="Monitor configuration" Style="{StaticResource Heading}"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,8"><StackPanel IsEnabled="{Binding CanEdit}">
        <TextBlock Text="Device name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Monitor device name"/><TextBlock Text="Host / IP" Margin="0,8,0,0"/><TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" AutomationProperties.Name="Monitor device address"/><TextBlock Text="Group" Margin="0,8,0,0"/><TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
        <WrapPanel Margin="0,10,0,8"><CheckBox Content="ICMP" IsChecked="{Binding UseIcmp}" Margin="0,0,10,0"/><CheckBox Content="TCP secondary" IsChecked="{Binding UseTcp}" Margin="0,0,10,0"/><CheckBox Content="SNMP" IsChecked="{Binding UseSnmp}"/></WrapPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="TCP port"/><TextBox Text="{Binding TcpPort}"/><TextBlock Text="ICMP interval (s)" Margin="0,8,0,0"/><TextBox Text="{Binding IcmpInterval}"/><TextBlock Text="Failure count" Margin="0,8,0,0"/><TextBox Text="{Binding FailureThreshold}"/><TextBlock Text="RTT warning (ms)" Margin="0,8,0,0"/><TextBox Text="{Binding WarningRtt}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Timeout (ms)"/><TextBox Text="{Binding Timeout}"/><TextBlock Text="SNMP interval (s)" Margin="0,8,0,0"/><TextBox Text="{Binding SnmpInterval}"/><TextBlock Text="Recovery count" Margin="0,8,0,0"/><TextBox Text="{Binding RecoveryThreshold}"/><TextBlock Text="Loss warning (%)" Margin="0,8,0,0"/><TextBox Text="{Binding WarningLoss}"/></StackPanel></Grid>
        <Expander Header="SNMP settings / credentials" IsExpanded="True" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="0,8,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Version"/><ComboBox ItemsSource="{Binding SnmpVersions}" SelectedItem="{Binding SnmpVersion}" AutomationProperties.Name="SNMP version"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="UDP port"/><TextBox Text="{Binding SnmpPort}"/></StackPanel></Grid>
          <TextBlock Text="Community (v1 / v2c)" Margin="0,8,0,0"/><PasswordBox x:Name="CommunityBox" MaxLength="128" AutomationProperties.Name="SNMP community"/>
          <StackPanel IsEnabled="{Binding IsV3}"><TextBlock Text="v3 username" Margin="0,8,0,0"/><TextBox Text="{Binding Username}" MaxLength="64"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Authentication"/><ComboBox ItemsSource="{Binding AuthAlgorithms}" SelectedItem="{Binding Authentication}"/><PasswordBox x:Name="AuthPasswordBox" MaxLength="128" AutomationProperties.Name="SNMP authentication password"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Privacy"/><ComboBox ItemsSource="{Binding PrivacyAlgorithms}" SelectedItem="{Binding Privacy}"/><PasswordBox x:Name="PrivacyPasswordBox" MaxLength="128" AutomationProperties.Name="SNMP privacy password"/></StackPanel></Grid></StackPanel>
          <TextBlock Text="SHA256/AES128 default; legacy algorithms are available for older agents. Blank fields during Test use saved credentials." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
          <Button Content="Save credentials securely" Click="SaveCredentials_Click"/><WrapPanel Margin="0,8,0,6"><CheckBox Content="System info" IsChecked="{Binding SystemInfo}" Margin="0,0,10,6"/><CheckBox Content="Interfaces" IsChecked="{Binding Interfaces}" Margin="0,0,10,6"/><CheckBox Content="Bandwidth" IsChecked="{Binding Bandwidth}" Margin="0,0,10,6"/><CheckBox Content="Errors / discards" IsChecked="{Binding Errors}"/></WrapPanel>
          <TextBlock Text="Utilization warning (%)"/><TextBox Text="{Binding WarningUtilization}"/><TextBlock Text="Other numeric OIDs · one per line" Margin="0,8,0,0"/><TextBox Text="{Binding CustomOids}" AcceptsReturn="True" Height="65" MaxLength="2600" VerticalScrollBarVisibility="Auto"/>
          <Button Content="Test SNMP / discover interfaces" Click="TestSnmp_Click" Margin="0,8,0,0" AutomationProperties.Name="Test SNMP before monitoring"/>
        </StackPanel></Expander>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8"/><UniformGrid Columns="2"><Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,4,6"/><Button Content="Cancel test" Command="{Binding CancelTestCommand}" Margin="4,0,0,6"/><Button Content="Start Monitoring" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"/><Button Content="Stop Monitoring" Command="{Binding StopCommand}" Style="{StaticResource StopButton}" Margin="4,0,0,0"/></UniformGrid></StackPanel>
    </Grid></Border><GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Resize monitor configuration"/>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Start all" Command="{Binding StartAllCommand}" Margin="0,0,5,0"/><Button Content="Stop all" Command="{Binding StopAllCommand}" Margin="0,0,5,0"/><Button Content="Export" Command="{Binding ExportCommand}"/></StackPanel><StackPanel><TextBlock Text="{Binding Activity}"/><WrapPanel><CheckBox Content="Notifications" IsChecked="{Binding Notifications}" Margin="0,4,12,0"/><CheckBox Content="Sound" IsChecked="{Binding Sound}" Margin="0,4,12,0"/><Button Content="Maintenance on/off" Command="{Binding MaintenanceCommand}" Margin="0,4,5,0"/><Button Content="Remove" Command="{Binding DeleteCommand}" Margin="0,4,0,0"/></WrapPanel></StackPanel></DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" RowHeight="NaN" MinRowHeight="30" b:ColumnLayout.Store="{Binding Store}" b:ColumnLayout.Key="MonitoringDevices" AutomationProperties.Name="Monitored devices"><DataGrid.Columns>
        <b:CopyableTextColumn Header="Device" Binding="{Binding Device.Name}" Width="160"/><b:CopyableTextColumn Header="Host / IP" Binding="{Binding Device.Host}" Width="150"/><b:CopyableTextColumn Header="Group" Binding="{Binding Device.Group}" Width="100"/><b:CopyableTextColumn Header="Auto-resume" Binding="{Binding Device.Started}" Width="100"/><b:CopyableTextColumn Header="State" Binding="{Binding Status}" Width="120"/><b:CopyableTextColumn Header="Last check (UTC)" Binding="{Binding Snapshot.LastCheck, StringFormat={}{0:HH:mm:ss}}" Width="140"/><b:CopyableTextColumn Header="RTT (ms)" Binding="{Binding Snapshot.RttMs, StringFormat={}{0:0.00}}" Width="95"/><b:CopyableTextColumn Header="Loss (%)" Binding="{Binding Snapshot.LossPercent, StringFormat={}{0:0.0}}" Width="85"/><b:CopyableTextColumn Header="Availability (%)" Binding="{Binding Snapshot.AvailabilityPercent, StringFormat={}{0:0.0}}" Width="120"/><b:CopyableTextColumn Header="SNMP" Binding="{Binding Snapshot.Snmp.Status}" Width="120"/><b:CopyableTextColumn Header="Evidence" Binding="{Binding Snapshot.Evidence}" Width="320" Wrap="True"/>
      </DataGrid.Columns></DataGrid>
      <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Resize monitoring results"/>
      <TabControl Style="{StaticResource ResultTabs}" Grid.Row="3">
        <TabItem Header="Interface / bandwidth"><DataGrid ItemsSource="{Binding InterfaceResults}" AutomationProperties.Name="Monitored interface results"><DataGrid.Columns><b:CopyableTextColumn Header="Index" Binding="{Binding Index}" Width="60"/><b:CopyableTextColumn Header="Interface" Binding="{Binding Name}" Width="150"/><b:CopyableTextColumn Header="Status" Binding="{Binding Status}" Width="155"/><b:CopyableTextColumn Header="In (Mbps)" Binding="{Binding InMbps, StringFormat={}{0:0.000}}" Width="100"/><b:CopyableTextColumn Header="Out (Mbps)" Binding="{Binding OutMbps, StringFormat={}{0:0.000}}" Width="100"/><b:CopyableTextColumn Header="Utilization (%)" Binding="{Binding UtilizationPercent, StringFormat={}{0:0.0}}" Width="110"/><b:CopyableTextColumn Header="New errors" Binding="{Binding NewErrors}" Width="100"/><b:CopyableTextColumn Header="New discards" Binding="{Binding NewDiscards}" Width="110"/><b:CopyableTextColumn Header="Observed changes" Binding="{Binding ObservedChanges}" Width="130"/><b:CopyableTextColumn Header="Evidence" Binding="{Binding Details}" Width="320"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="SNMP Test / choose interfaces"><Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox Text="{Binding SnmpTestDetails, Mode=OneWay}" Style="{StaticResource TableText}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><DataGrid Grid.Row="1" ItemsSource="{Binding DiscoveredInterfaces}" IsReadOnly="False" AutomationProperties.Name="Discovered SNMP interfaces"><DataGrid.Columns><DataGridTemplateColumn Header="Monitor" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Watched, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><b:CopyableTextColumn Header="Index" Binding="{Binding Data.Index}" Width="70" IsReadOnly="True"/><b:CopyableTextColumn Header="Interface" Binding="{Binding Data.Name}" Width="240" IsReadOnly="True"/><b:CopyableTextColumn Header="Admin" Binding="{Binding Data.AdminStatus}" Width="80" IsReadOnly="True"/><b:CopyableTextColumn Header="Oper" Binding="{Binding Data.OperStatus}" Width="80" IsReadOnly="True"/><b:CopyableTextColumn Header="Speed (bits/s)" Binding="{Binding Data.SpeedBits}" Width="150" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        <TabItem Header="Device / other OIDs"><TextBox Text="{Binding SelectedDetails, Mode=OneWay}" Style="{StaticResource TableText}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></TabItem>
        <TabItem Header="Incidents"><DataGrid ItemsSource="{Binding Incidents}" RowHeight="NaN" MinRowHeight="30" AutomationProperties.Name="Monitoring incidents"><DataGrid.Columns><b:CopyableTextColumn Header="Device" Binding="{Binding DeviceName}" Width="160"/><b:CopyableTextColumn Header="Kind" Binding="{Binding Kind}" Width="150"/><b:CopyableTextColumn Header="Started (UTC)" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180"/><b:CopyableTextColumn Header="Ended (UTC)" Binding="{Binding EndedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180"/><DataGridTemplateColumn Header="Incident span" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource TableText}"><TextBox.Text><MultiBinding Converter="{StaticResource IncidentDuration}"><Binding Path="StartedAt"/><Binding Path="EndedAt"/><Binding Path="DataContext.Clock" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBox.Text></TextBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><b:CopyableTextColumn Header="Details" Binding="{Binding Details}" Width="350" Wrap="True"/></DataGrid.Columns></DataGrid></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
