<UserControl x:Class="NetStucked.Desktop.Views.TerminalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="250"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Host keys…" Click="HostKeys_Click" AutomationProperties.Name="Manage SSH host keys"/><TextBlock Text="Connection" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding SelectedTab.CanEdit}">
        <TextBlock Text="Saved profile"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Terminal saved profile"/>
        <UniformGrid Columns="2" Margin="0,6,0,10"><Button Content="Save profile" Command="{Binding SaveProfileCommand}" Margin="0,0,3,0"/><Button Content="Delete" Command="{Binding DeleteProfileCommand}" Margin="3,0,0,0"/></UniformGrid>
        <TextBlock Text="Session name"/><TextBox Text="{Binding SelectedTab.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Terminal session name"/>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Host / IP"/><TextBox Text="{Binding SelectedTab.Host, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" AutomationProperties.Name="Terminal host"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Port"/><TextBox Text="{Binding SelectedTab.Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal port"/></StackPanel></Grid>
        <TextBlock Text="Protocol" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedTab.Protocol}" AutomationProperties.Name="Terminal protocol"/>
        <CheckBox Content="Allow plaintext Telnet" IsChecked="{Binding SelectedTab.AllowTelnet}" Visibility="{Binding SelectedTab.IsTelnet, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"/>
        <TextBlock Text="Log in interactively in the terminal. Telnet traffic is unencrypted." TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="{Binding SelectedTab.IsTelnet, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"/>
        <StackPanel Visibility="{Binding SelectedTab.IsSsh, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="Username" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedTab.Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Terminal username"/>
          <TextBlock Text="Authentication" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Authentications}" SelectedItem="{Binding SelectedTab.Authentication}" AutomationProperties.Name="Terminal authentication"/>
          <StackPanel Visibility="{Binding SelectedTab.IsPassword, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Password · this connection only" Margin="0,8,0,0"/><PasswordBox x:Name="Password" MaxLength="512" AutomationProperties.Name="Terminal password"/></StackPanel>
          <StackPanel Visibility="{Binding SelectedTab.IsPrivateKey, Converter={StaticResource BoolVisibility}}"><TextBlock Text="OpenSSH private-key file" Margin="0,8,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="…" Click="Key_Click" AutomationProperties.Name="Choose terminal private key"/><TextBox Text="{Binding SelectedTab.KeyPath, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/></DockPanel><TextBlock Text="Key passphrase · this connection only" Margin="0,8,0,0"/><PasswordBox x:Name="Passphrase" MaxLength="512"/></StackPanel>
          <TextBlock Text="New SSH hosts ask for confirmation on Connect. Save the key to recognize the device next time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button Content="Connect" Click="Connect_Click" IsEnabled="{Binding SelectedTab.CanEdit}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/></StackPanel>
    </Grid></Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
    <Border Grid.Column="2" Style="{StaticResource Card}"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="+" Command="{Binding AddTabCommand}" AutomationProperties.Name="New terminal tab"/><Button Content="Close" Command="{Binding CloseTabCommand}" Margin="4,0,0,0"/></StackPanel><ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" AutomationProperties.Name="Terminal sessions" Margin="0,0,8,0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="8,4"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Copy" Click="Copy_Click"/><Button Content="Paste" Click="Paste_Click" Margin="4,0,0,0"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding SelectedTab.State}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/></DockPanel>
      <ContentControl Grid.Row="2" x:Name="BrowserHost" AutomationProperties.Name="Interactive terminal emulator"/>
      <TextBlock Grid.Row="3" Text="{Binding SelectedTab.Message}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="90" AutomationProperties.Name="Terminal status"/>
    </Grid></Border>
  </Grid>
</UserControl>
