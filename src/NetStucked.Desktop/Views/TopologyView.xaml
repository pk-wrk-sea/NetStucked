<UserControl x:Class="NetStucked.Desktop.Views.TopologyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" xmlns:views="clr-namespace:NetStucked.Desktop.Views" Style="{StaticResource {x:Type UserControl}}">
  <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Analyze existing data" Command="{Binding AnalyzeCommand}" Margin="6,0"/><Button Content="Reanalyze source" Command="{Binding ReanalyzeSourceCommand}" IsEnabled="{Binding Workspace.CanEdit}" Margin="6,0"/><Button Content="Export links" Command="{Binding ExportCommand}"/></WrapPanel><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Host" MinWidth="180" IsEnabled="{Binding Workspace.CanEdit}" AutomationProperties.Name="Topology evidence device"/></DockPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8"/></StackPanel>
    <TabControl Grid.Row="1" Style="{StaticResource ResultTabs}"><TabItem Header="One-hop graph"><views:TopologyGraph/></TabItem><TabItem Header="Neighbors / links"><DataGrid ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" AutomationProperties.Name="Topology links"><DataGrid.Columns><b:CopyableTextColumn Header="Neighbor" Binding="{Binding Neighbor}" Width="180"/><b:CopyableTextColumn Header="Address" Binding="{Binding Address}" Width="145"/><b:CopyableTextColumn Header="Local interface" Binding="{Binding LocalInterface}" Width="160"/><b:CopyableTextColumn Header="Remote interface" Binding="{Binding RemoteInterface}" Width="160"/><b:CopyableTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/><b:CopyableTextColumn Header="Evidence class" Binding="{Binding Classification}" Width="250"/><b:CopyableTextColumn Header="Freshness" Binding="{Binding Freshness}" Width="150"/><b:CopyableTextColumn Header="Source line" Binding="{Binding Line}" Width="90"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Interfaces / routing / facts"><DataGrid ItemsSource="{Binding Facts}" AutomationProperties.Name="Parsed device facts"><DataGrid.Columns><b:CopyableTextColumn Header="Field" Binding="{Binding Field}" Width="160"/><b:CopyableTextColumn Header="Observed value" Binding="{Binding Value}" Width="*"/><b:CopyableTextColumn Header="Source command" Binding="{Binding Command}" Width="240"/><b:CopyableTextColumn Header="Line" Binding="{Binding Line}" Width="75"/><b:CopyableTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="190"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Config comparison"><Grid Margin="6" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Compare previous capture" Command="{Binding ComparePreviousCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding ConfigurationDiff, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" b:ResultZoom.Enabled="True" AutomationProperties.Name="Captured configuration comparison"/></Grid></TabItem></TabControl>
    <StackPanel Grid.Row="2"><TextBox Text="{Binding LinkDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="125" Margin="0,8,0,0" b:ResultZoom.Enabled="True" AutomationProperties.Name="Topology link evidence inspector"/><TextBlock Text="{Binding Workspace.Message}" TextWrapping="Wrap"/></StackPanel>
  </Grid></Border>
</UserControl>
