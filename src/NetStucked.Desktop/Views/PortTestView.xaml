<UserControl x:Class="NetStucked.Desktop.Views.PortTestView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid b:SlideTrack.IsExpanded="{Binding AddressesExpanded}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><Button DockPanel.Dock="Right" Content="&#xE700;" Style="{StaticResource IconButton}" Command="{Binding ToggleAddressesCommand}" AutomationProperties.Name="Toggle slide bar: addresses"/><TextBlock Text="TCP / UDP Endpoint Test" Style="{StaticResource Heading}" FontSize="13" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,12,0,10" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox b:Watermark.Text="Choose address template" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" IsEnabled="{Binding CanEdit}" TextSearch.TextPath="Name" AutomationProperties.Name="Choose TCP endpoint template" ToolTip="Choose a saved address template" Margin="0,0,6,0">
            <ComboBox.ItemTemplate><DataTemplate><DockPanel MinWidth="180"><Button DockPanel.Dock="Right" Content="×" Command="{Binding DeleteCommand}" Padding="4,0" Width="24" MinHeight="22" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Delete address template"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0"/></DockPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="&#xE74E;" Command="{Binding SaveCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Save address template" Margin="0,0,8,0"/>
          <Button Grid.Column="2" Content="&#xE713;" Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="Probe Settings"/>
        </Grid>
        <Grid Grid.Row="2" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Background="{DynamicResource InputBrush}">
          <TextBox b:Watermark.Text="Input Host, IP or CIDR&#x0a;Optional description after a space" Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000000" IsReadOnly="{Binding CanEdit, Converter={x:Static b:BooleanInverter.Instance}}" AcceptsReturn="True" AcceptsTab="False" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="2,4" Background="Transparent" FontSize="13" AutomationProperties.Name="Port test hosts or CIDR"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="Port protocol" Margin="0,0,8,0"/><TextBox Grid.Column="1" Text="{Binding PortNumbers, UpdateSourceTrigger=PropertyChanged}" b:Watermark.Text="22,443,1000-1005" MaxLength="2048" AutomationProperties.Name="Ports to test"/></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><ComboBox b:Watermark.Text="Standard port template" ItemsSource="{Binding PortTemplateNames}" SelectedItem="{Binding SelectedPortTemplate}" AutomationProperties.Name="Standard port template" Margin="0,0,5,0"/><Button Grid.Column="1" Content="&#xE70F;" Style="{StaticResource IconButton}" Command="{Binding EditPortTemplateCommand}" AutomationProperties.Name="Edit port template"/><Button Grid.Column="2" Content="&#xE74E;" Style="{StaticResource IconButton}" Command="{Binding SavePortNumbersCommand}" AutomationProperties.Name="Save port template"/><Button Grid.Column="3" Content="&#xE777;" Style="{StaticResource IconButton}" Command="{Binding RestorePortTemplateCommand}" AutomationProperties.Name="Restore default ports"/></Grid>
          <CheckBox Content="I authorize this scan above 4,096 checks" IsChecked="{Binding ScopeAcknowledged}" Visibility="{Binding RequiresScopeAcknowledgement, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><CheckBox.ToolTip><TextBlock Text="Maximum 1,024 hosts, 64 selected ports, 16,384 checks; 32 concurrent probes." TextWrapping="Wrap" MaxWidth="280"/></CheckBox.ToolTip></CheckBox>
        </StackPanel></Grid>
        <ScrollViewer Grid.Row="3" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,6,0,4"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="11"/></ScrollViewer>
        <StackPanel Grid.Row="4" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,10"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/><TextBlock Text="{Binding ProtocolGuide}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/><TextBlock Text="{Binding TargetPreview}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
        <UniformGrid Grid.Row="5" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}" Columns="3"><Button Content="▶  Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,5,0"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" Margin="3,0,3,0" Padding="6,7"/><Button Content="●  Stop" Style="{StaticResource StopButton}" Command="{Binding StopCommand}" Margin="5,0,0,0"/></UniformGrid>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="{Binding AddressesExpanded, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Resize addresses panel"/>
    <Grid Grid.Column="2" b:SlideTrack.Index="4" b:SlideTrack.Axis="Vertical" b:SlideTrack.IsExpanded="{Binding HistoryExpanded}"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="10"/><RowDefinition Height="1.2*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <UniformGrid Columns="6" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Targets" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TargetCount, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="{Binding SuccessLabel}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Reachable, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Failed" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Unreachable, StringFormat=N0}" Foreground="{DynamicResource DangerBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="Attempts" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Sent, StringFormat=N0}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="No response" Style="{StaticResource Muted}"/><TextBlock Text="{Binding NoResponse, StringFormat=N0}" Foreground="{DynamicResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="8"><StackPanel><TextBlock Text="{Binding FailureLabel}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Loss, StringFormat={}{0:0.0}%}" Foreground="{DynamicResource WarningBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="130" Margin="0,0,10,0" AutomationProperties.Name="Realtime status filter"/><Button Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitResults_Click" AutomationProperties.Name="Fit Columns" Margin="0,0,8,0"/><Button Content="&#xE80A;" Style="{StaticResource IconButton}" Click="Columns_Click" AutomationProperties.Name="Configure realtime columns" Margin="0,0,8,0"/><Button Content="&#xE896;" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" AutomationProperties.Name="Export realtime results to CSV"/></StackPanel><TextBlock Style="{StaticResource Heading}"><Run Text="Realtime Results "/><Run Text="{Binding TargetCount, StringFormat={}({0} endpoints)}" FontSize="12" FontWeight="Normal"/></TextBlock></DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" b:GridTools.UnselectCommand="{Binding UnselectCommand}" RowStyle="{StaticResource StatusRow}" b:ColumnLayout.Store="{Binding Store}" b:ColumnLayout.Key="Port" FrozenColumnCount="2" AutomationProperties.Name="TCP Port Test Results">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/>
            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/><DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="160"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="110"/>
            <DataGridTextColumn Header="Resolved IP" Binding="{Binding ResolvedIp, TargetNullValue=—}" Width="130"/>
            <DataGridTextColumn Header="Response (ms)" Binding="{Binding Last, StringFormat=0.##, TargetNullValue=—}" Width="100"/>
            <DataGridTextColumn Header="Avg (ms)" Binding="{Binding Average, StringFormat=0.##, TargetNullValue=—}" Width="80"/>
            <DataGridTextColumn Header="Min (ms)" Binding="{Binding Minimum, StringFormat=0.##, TargetNullValue=—}" Width="80"/>
            <DataGridTextColumn Header="Max (ms)" Binding="{Binding Maximum, StringFormat=0.##, TargetNullValue=—}" Width="80"/>
            <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="75"/>
            <DataGridTextColumn Header="Successes" Binding="{Binding Connected}" Width="85"/>
            <DataGridTextColumn Header="No success %" Binding="{Binding FailurePercent, StringFormat={}{0:0.0}%}" Width="80"/>
            <DataGridTextColumn Header="Last test" Binding="{Binding LastTest, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccess, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="155"/>
            <DataGridTextColumn Header="Result / error" Binding="{Binding Details}" Width="*" MinWidth="200"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></Border>
      <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Visibility="{Binding HistoryExpanded, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Resize history panel"/>
      <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="3,0,3,10"><Button DockPanel.Dock="Right" Content="&#xE700;" Style="{StaticResource IconButton}" Command="{Binding ToggleHistoryCommand}" AutomationProperties.Name="Toggle slide bar: history" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Visibility="{Binding HistoryExpanded, Converter={StaticResource BoolVisibility}}" Content="&#xE8B5;" Style="{StaticResource IconButton}" Click="FitHistory_Click" AutomationProperties.Name="Fit History Columns" Margin="8,0,0,0"/><ComboBox DockPanel.Dock="Right" Visibility="{Binding HistoryExpanded, Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding HistoryLimits}" SelectedItem="{Binding HistoryLimit}" Width="110" AutomationProperties.Name="Connection History retention display"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}Last {0}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/></DockPanel>
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" Visibility="{Binding HistoryExpanded, Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding History, NotifyOnTargetUpdated=True}" AutomationProperties.Name="Selected endpoint Connection History"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="190"/><DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="55"/><DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Response (ms)" Binding="{Binding ConnectMs, StringFormat=0.##, TargetNullValue=—}" Width="120"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="100"/></DataGrid.Columns></DataGrid>
      </Grid></Border>
    </Grid>
  </Grid>
</UserControl>
