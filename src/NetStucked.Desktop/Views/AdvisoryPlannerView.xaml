<UserControl x:Class="NetStucked.Desktop.Views.AdvisoryPlannerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><TextBox Text="{Binding Cve, UpdateSourceTrigger=PropertyChanged}" MaxLength="22" Width="190" b:Watermark.Text="CVE-YYYY-NNNN" AutomationProperties.Name="CVE identifier"/><Button Content="Fetch NVD + KEV" Command="{Binding FetchCommand}" Margin="8,0"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Reload local cache" Command="{Binding ReloadCommand}" Margin="8,0"/></WrapPanel>
      <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Cached advisory"/><ComboBox ItemsSource="{Binding Advisories}" SelectedItem="{Binding SelectedAdvisory}" DisplayMemberPath="Cve" AutomationProperties.Name="Cached advisory"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Asset to review / plan"/><ComboBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="Hostname" AutomationProperties.Name="Advisory review asset"/></StackPanel></Grid>
    </StackPanel>
    <TabControl Grid.Row="1" Style="{StaticResource ResultTabs}" IsEnabled="{Binding Workspace.CanEdit}">
      <TabItem Header="Metadata / assessments"><Grid Margin="6" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox Text="{Binding AdvisoryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" b:ResultZoom.Enabled="True" AutomationProperties.Name="Advisory source metadata"/><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/><DataGrid Grid.Row="2" ItemsSource="{Binding Assessments}" AutomationProperties.Name="Asset advisory assessments"><DataGrid.Columns><b:CopyableTextColumn Header="Device" Binding="{Binding Asset.Hostname}" Width="160"/><b:CopyableTextColumn Header="Observed version" Binding="{Binding Version}" Width="160"/><b:CopyableTextColumn Header="Assessment" Binding="{Binding State}" Width="260"/><b:CopyableTextColumn Header="Reason / limitations" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem Header="Engineer review"><ScrollViewer TextElement.Foreground="{DynamicResource TextBrush}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="8" MaxWidth="1000" HorizontalAlignment="Stretch"><TextBlock Text="{Binding CurrentEvidence}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Decision (scoped to this advisory)"/><ComboBox ItemsSource="{Binding Decisions}" SelectedItem="{Binding Decision}" AutomationProperties.Name="Applicability decision"/>
        <TextBlock Text="Product / version evidence (match official advisory conditions)" Margin="0,8,0,0"/><TextBox Text="{Binding ProductEvidence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" Height="75" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Configuration / feature applicability evidence" Margin="0,8,0,0"/><TextBox Text="{Binding ConfigurationEvidence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" Height="75" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Official Cisco advisory URL (HTTPS)" Margin="0,8,0,0"/><TextBox Text="{Binding VendorUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024"/>
        <TextBlock Text="Engineer" Margin="0,8,0,0"/><TextBox Text="{Binding Engineer, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Reason / evaluated conditions" Margin="0,8,0,0"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" Height="75" VerticalScrollBarVisibility="Auto"/>
        <Button Content="Record engineer review" Command="{Binding SaveReviewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,8"/><TextBlock Text="Observations older than 30 days or advisory/review older than 7 days require re-review. New evidence or advisory revision invalidates an older assessment." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Device upgrade plans"><Grid Margin="6" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="250"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel><Button Content="New draft" Command="{Binding NewPlanCommand}"/><Button Content="Save draft" Command="{Binding SaveDraftCommand}" Margin="6,0,0,0"/></WrapPanel>
          <TextBlock Text="Target release (no automatic safe version)" Margin="0,8,0,0"/><TextBox Text="{Binding TargetVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Official first-fixed evidence URL" Margin="0,8,0,0"/><TextBox Text="{Binding FixedUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024"/>
          <TextBlock Text="Official hardware / feature compatibility URL" Margin="0,8,0,0"/><TextBox Text="{Binding CompatibilityUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024"/>
          <TextBlock Text="Change owner" Margin="0,8,0,0"/><TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Change ID" Margin="0,8,0,0"/><TextBox Text="{Binding ChangeId, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Wave / dependencies" Margin="0,8,0,0"/><TextBox Text="{Binding Wave, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Window UTC · ISO 8601 e.g. 2026-11-01T01:00:00Z" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBox Text="{Binding WindowUtc, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Approving engineer" Margin="0,8,0,0"/><TextBox Text="{Binding Engineer, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
          <TextBlock Text="Notes / before-after verification" Margin="0,8,0,0"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" Height="85" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <Button Content="Engineer approval…" Command="{Binding ApprovePlanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,6"/><Button Content="Compare newer post-change evidence" Command="{Binding CompareAfterCommand}"/><TextBlock Text="Saving edits creates a draft and clears prior approval. Approval records a plan only; device upgrade execution is performed outside NetStucked." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8"/>
        </StackPanel></ScrollViewer>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns"/>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0"/><Button Content="Export Excel" Command="{Binding ExportWorkbookCommand}" Margin="0,0,6,0"/><Button Content="Export HTML" Command="{Binding ExportHtmlCommand}"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" AutomationProperties.Name="Device upgrade plans"><DataGrid.Columns><b:CopyableTextColumn Header="Device" Binding="{Binding Device}" Width="150"/><b:CopyableTextColumn Header="CVE" Binding="{Binding Plan.Cve}" Width="160"/><b:CopyableTextColumn Header="Target" Binding="{Binding Plan.TargetVersion}" Width="135"/><b:CopyableTextColumn Header="State" Binding="{Binding State}" Width="280"/><b:CopyableTextColumn Header="Owner" Binding="{Binding Plan.Owner}" Width="150"/><b:CopyableTextColumn Header="Change" Binding="{Binding Plan.ChangeId}" Width="130"/><b:CopyableTextColumn Header="Wave" Binding="{Binding Plan.Wave}" Width="130"/><b:CopyableTextColumn Header="Window" Binding="{Binding Plan.WindowUtc}" Width="220"/><b:CopyableTextColumn Header="Approved by" Binding="{Binding Plan.ApprovedBy}" Width="160"/></DataGrid.Columns></DataGrid></Grid>
      </Grid></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Workspace.Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid></Border>
</UserControl>
