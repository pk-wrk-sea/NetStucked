<UserControl x:Class="NetStucked.Desktop.Views.UpdatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="6,0,0,0">
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Background="#D8F5E5" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"><TextBlock Text="Running" Foreground="#008957" FontSize="11"/></Border><StackPanel><TextBlock Text="Current Version" Style="{StaticResource Muted}"/><TextBlock Text="{Binding CurrentVersion, StringFormat={}v{0}}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></DockPanel>
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,18"/>
        <DockPanel><Border DockPanel.Dock="Right" Background="#E0ECFF" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"><TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border><StackPanel><TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel></DockPanel>
        <Border Background="#F4F7FC" CornerRadius="6" Padding="13" Margin="0,15,0,12"><StackPanel><TextBlock Text="Release Notes" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{Binding Notes}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border>
        <UniformGrid Columns="2"><Button Content="{Binding DownloadLabel}" Command="{Binding OpenReleaseCommand}" Style="{StaticResource PrimaryButton}" MinHeight="44" Margin="0,0,4,0" AutomationProperties.Name="Open available GitHub release for manual installation"/><Button Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" MinHeight="44" Margin="4,0,0,0" AutomationProperties.Name="Check GitHub Releases"/></UniformGrid>
        <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Version Recovery" Style="{StaticResource Heading}"/></StackPanel>
        <DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Rollback guide" Command="{Binding RecoveryCommand}" AutomationProperties.Name="Show manual rollback guide"/><StackPanel><TextBlock Text="{Binding PreviousVersion}"/><TextBlock Text="Restore a previous version manually" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
        <StackPanel Visibility="{Binding ShowRecoveryGuide, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"><TextBlock Text="{Binding RecoveryInstructions}" TextWrapping="Wrap" LineHeight="22"/><Button Content="Open published versions ↗" Command="{Binding OpenReleasesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14"/>
        <DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="False" IsEnabled="False" ToolTip="Manual checks only in this version." AutomationProperties.Name="Automatic update checking is unavailable"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border Width="32" Height="18" CornerRadius="9" Background="#C8D2E1"><Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/></Border></ControlTemplate></CheckBox.Template></CheckBox><TextBlock Text="Automatically check for updates"/></DockPanel>
        <TextBlock Text="Manual checks and installation only. Automatic updates are not enabled." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Version History" Style="{StaticResource Heading}"/><TextBlock Text="Changes recorded in this application. Published release notes appear above after a check." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Expander IsExpanded="True" Margin="0,6,0,4"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Version, StringFormat={}v{0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/></StackPanel></Expander.Header><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21" Margin="20,8,0,8"/></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
