<UserControl x:Class="NetStucked.Desktop.Views.MacCheckerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <UserControl.Resources><b:BindingProxy x:Key="MacVm" Data="{Binding}"/></UserControl.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="MAC addresses" Style="{StaticResource Heading}"/><TextBox Grid.Row="1" Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsRunning}" MaxLength="65536" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" b:Watermark.Text="Paste MAC / ARP output&#x0a;00:11:22:33:44:55&#x0a;0011.2233.4455" AutomationProperties.Name="MAC addresses" Margin="0,10,0,10"/><StackPanel Grid.Row="2"><TextBlock Text="MACVendors.com · queued API lookups, cached for one day. Locally administered addresses do not prove manufacturer identity." Style="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,10"/><UniformGrid Columns="2"><Button Content="Check" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"/><Button Content="Stop" Command="{Binding StopCommand}" Margin="4,0,0,0"/></UniformGrid></StackPanel></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Export CSV" Command="{Binding ExportCommand}"/><TextBlock Text="Vendor lookup" Style="{StaticResource Heading}"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="MAC vendor lookup results"><DataGrid.Columns><b:CopyableTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="160" Visibility="{Binding Data.HasIpMatches, Source={StaticResource MacVm}, Converter={StaticResource BoolVisibility}}"/><b:CopyableTextColumn Header="MAC" Binding="{Binding Address}" Width="170"/><b:CopyableTextColumn Header="OUI" Binding="{Binding Oui}" Width="95"/><b:CopyableTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="200"/><b:CopyableTextColumn Header="Address type" Binding="{Binding AddressType}" Width="170"/><b:CopyableTextColumn Header="Status" Binding="{Binding Status}" Width="130"/><b:CopyableTextColumn Header="Checked at (UTC)" Binding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170"/><b:CopyableTextColumn Header="Source / detail" Binding="{Binding Details}" Width="300"/></DataGrid.Columns></DataGrid></Grid></Border>
  </Grid>
</UserControl>
