<UserControl x:Class="NetStucked.Desktop.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="240"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="New" Command="{Binding NewAssetCommand}"/><TextBlock Text="Asset / MA record" Style="{StaticResource Heading}"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8" IsEnabled="{Binding Workspace.CanEdit}"><StackPanel>
        <TextBlock Text="Stable Asset ID"/><TextBox Text="{Binding AssetId, Mode=OneWay}" IsReadOnly="True" FontSize="10"/>
        <TextBlock Text="Hostname"/><TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="Asset hostname"/>
        <TextBlock Text="Management address"/><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" AutomationProperties.Name="Asset address"/>
        <TextBlock Text="Vendor"/><TextBox Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Model (human record)"/><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Serial (human record)"/><TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Site"/><TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Location"/><TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Role"/><TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="Contract"/><TextBox Text="{Binding Contract, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"/>
        <TextBlock Text="MA start · yyyy-MM-dd"/><TextBox Text="{Binding MaStart, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
        <TextBlock Text="MA end · yyyy-MM-dd"/><TextBox Text="{Binding MaEnd, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2"><WrapPanel><Button Content="Save" Command="{Binding SaveAssetCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"/><Button Content="Delete" Command="{Binding DeleteAssetCommand}" Margin="0,0,6,4"/><Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,0,4"/></WrapPanel><TextBlock Text="{Binding Workspace.Message}" TextWrapping="Wrap" MaxHeight="90"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" Margin="0,6,0,0"/></StackPanel>
    </Grid></Border><GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns"/>
    <Border Grid.Column="2" Style="{StaticResource Card}"><TabControl Style="{StaticResource ResultTabs}" IsEnabled="{Binding Workspace.CanEdit}">
      <TabItem Header="Assets"><Grid Margin="6" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="130" MinHeight="70"/></Grid.RowDefinitions>
        <StackPanel><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" b:Watermark.Text="Search hostname, IP, model, serial, site, MA…" AutomationProperties.Name="Search inventory"/><WrapPanel Margin="0,6"><Button Content="Export Excel" Command="{Binding ExportWorkbookCommand}" Margin="0,0,6,4"/><Button Content="Template" Command="{Binding TemplateCommand}" Margin="0,0,6,4"/><Button Content="Import preview" Command="{Binding ImportPreviewCommand}" Margin="0,0,6,4"/><Button Content="Attach Collector evidence" Command="{Binding ImportEvidenceCommand}" Margin="0,0,6,4"/><Button Content="Export audit" Command="{Binding ExportAuditCommand}" Margin="0,0,6,4"/><Button Content="Export observations" Command="{Binding ExportObservationsCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" AutomationProperties.Name="MA inventory assets"><DataGrid.Columns><b:CopyableTextColumn Header="Hostname" Binding="{Binding Asset.Hostname}" Width="155"/><b:CopyableTextColumn Header="Address" Binding="{Binding Asset.Address}" Width="145"/><b:CopyableTextColumn Header="MA" Binding="{Binding Asset.MaStatus}" Width="140"/><b:CopyableTextColumn Header="MA end" Binding="{Binding Asset.MaEnd}" Width="110"/><b:CopyableTextColumn Header="Site" Binding="{Binding Asset.Site}" Width="120"/><b:CopyableTextColumn Header="Model (human)" Binding="{Binding Asset.Model}" Width="150"/><b:CopyableTextColumn Header="Serial (human)" Binding="{Binding Asset.Serial}" Width="150"/><b:CopyableTextColumn Header="Observed version" Binding="{Binding ObservedVersion}" Width="155"/><b:CopyableTextColumn Header="Observed model" Binding="{Binding ObservedModel}" Width="155"/><b:CopyableTextColumn Header="Observed serial" Binding="{Binding ObservedSerial}" Width="155"/><b:CopyableTextColumn Header="Last collected UTC" Binding="{Binding LastCollected, StringFormat=u}" Width="175"/><b:CopyableTextColumn Header="Asset ID" Binding="{Binding Asset.Id}" Width="280"/></DataGrid.Columns></DataGrid>
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/><TextBox Grid.Row="3" Text="{Binding EvidenceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" b:ResultZoom.Enabled="True" AutomationProperties.Name="Asset observation provenance"/>
      </Grid></TabItem>
      <TabItem Header="Import preview"><Grid Margin="6" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap"/><WrapPanel Margin="0,6"><Button Content="Choose workbook" Command="{Binding ImportPreviewCommand}" Margin="0,0,6,0"/><Button Content="Select valid rows" Command="{Binding SelectValidCommand}" Margin="0,0,6,0"/><Button Content="Apply selected" Command="{Binding ApplyImportCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Preview}" IsReadOnly="False" AutomationProperties.Name="Inventory import preview"><DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Row" Binding="{Binding Data.Row}" IsReadOnly="True" Width="60"/><DataGridTextColumn Header="Action" Binding="{Binding Data.Action}" IsReadOnly="True" Width="210"/><DataGridTextColumn Header="Hostname" Binding="{Binding Data.Asset.Hostname}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Address" Binding="{Binding Data.Asset.Address}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Model" Binding="{Binding Data.Asset.Model}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Serial" Binding="{Binding Data.Asset.Serial}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="Site" Binding="{Binding Data.Asset.Site}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="MA end" Binding="{Binding Data.Asset.MaEnd}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Error" Binding="{Binding Data.Error}" IsReadOnly="True" Width="350"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    </TabControl></Border>
  </Grid>
</UserControl>
