<UserControl x:Class="NetStucked.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="200"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="140"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Refresh" Command="{Binding RefreshCommand}"/><StackPanel><TextBlock Text="Operational overview" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,5"/><TextBlock Text="{Binding Updated}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Workspace.Message}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Tools}" AutomationProperties.Name="Operational tool status"><DataGrid.Columns><b:CopyableTextColumn Header="Tool" Binding="{Binding Menu}" Width="175"/><b:CopyableTextColumn Header="State" Binding="{Binding State}" Width="125"/><b:CopyableTextColumn Header="Observed application activity" Binding="{Binding Detail}" Width="*"/><DataGridTemplateColumn Header="Open" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Menu}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
    <Border Grid.Row="3" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Recent local monitoring incidents · latest 50" Style="{StaticResource Heading}" Margin="0,0,0,8"/><DataGrid Grid.Row="1" ItemsSource="{Binding Incidents}" AutomationProperties.Name="Recent monitoring incidents"><DataGrid.Columns><b:CopyableTextColumn Header="Device" Binding="{Binding DeviceName}" Width="180"/><b:CopyableTextColumn Header="Kind" Binding="{Binding Kind}" Width="160"/><b:CopyableTextColumn Header="Started UTC" Binding="{Binding StartedAt, StringFormat=u}" Width="175"/><b:CopyableTextColumn Header="Ended UTC" Binding="{Binding EndedAt, StringFormat=u}" Width="175"/><b:CopyableTextColumn Header="Evidence" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
  </Grid>
</UserControl>
