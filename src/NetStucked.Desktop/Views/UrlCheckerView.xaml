<UserControl x:Class="NetStucked.Desktop.Views.UrlCheckerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type UserControl}}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Website reputation and URL categories" Style="{StaticResource Heading}"/><TextBlock Text="URL or domain" Style="{StaticResource Muted}" Margin="0,12,0,5"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" AutomationProperties.Name="URL to check"/><Button Content="Check URL" Command="{Binding CheckCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Margin="0,10,0,10"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="VirusTotal" Style="{StaticResource Heading}"/><TextBlock Text="{Binding VirusTotalStatus}" Margin="0,8,0,8"/><TextBlock Text="Malicious / suspicious: —    Harmless / undetected: —    Last analysis: —" TextWrapping="Wrap" Style="{StaticResource Muted}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Palo Alto Networks" Style="{StaticResource Heading}"/><TextBlock Text="{Binding PaloAltoStatus}" TextWrapping="Wrap" Margin="0,8,0,8"/><TextBlock Text="URL categories: —    Source / checked at: —" Style="{StaticResource Muted}"/><TextBlock Text="Test A Site is a public website; an API integration must use a supported service or PAN-OS endpoint. No result has been retrieved." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
