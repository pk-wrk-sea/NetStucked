<UserControl x:Class="NetStucked.Desktop.Views.UrlCheckerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:NetStucked.Desktop.Behaviors" Style="{StaticResource {x:Type UserControl}}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Website reputation and URL categories" Style="{StaticResource Heading}"/>
      <Grid Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" b:Watermark.Text="URL or domain" AutomationProperties.Name="URL to check"/><Button Grid.Column="1" Content="Check URL" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}" Margin="8,0,0,0"/></Grid>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></Border>
    <TabControl Style="{StaticResource ResultTabs}" Grid.Row="1" Margin="0,12,0,0">
      <TabItem Header="VirusTotal"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding VirusTotalStatus}" Margin="0,0,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="Remove key" Command="{Binding RemoveKeyCommand}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Save key securely" Click="SaveKey_Click" Margin="8,0,0,0"/><PasswordBox x:Name="ApiKeyBox" MaxLength="256" AutomationProperties.Name="VirusTotal account API key"/></DockPanel><TextBlock Text="Personal account · existing report lookup · provider quota respected" Style="{StaticResource Muted}" Margin="0,6,0,10"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" b:ResultZoom.Enabled="True"><StackPanel><TextBlock Text="{Binding Result.Status}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Result.Url}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Text="{Binding Result.Malicious, StringFormat=Malicious: {0}}"/><TextBlock Text="{Binding Result.Suspicious, StringFormat=Suspicious: {0}}"/><TextBlock Text="{Binding Result.Harmless, StringFormat=Harmless: {0}}"/><TextBlock Text="{Binding Result.Undetected, StringFormat=Undetected: {0}}"/><TextBlock Text="{Binding Result.LastAnalysis, StringFormat=Last analysis (UTC): {0:yyyy-MM-dd HH:mm:ss}}" Margin="0,12,0,8"/><TextBlock Text="{Binding Result.Details}" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid></TabItem>
      <TabItem Header="Palo Alto · Test A Site"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Copy URL" Click="CopyUrl_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Open Test A Site" Click="OpenPalo_Click" Margin="8,0,0,0"/><TextBlock Text="{Binding PaloAltoStatus}" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="BrowserStatus" Text="Open the provider page, then search with its form. Results appear here. Ctrl+mouse wheel zooms the website." TextWrapping="Wrap" Margin="0,8,0,8"/></StackPanel><ContentControl x:Name="BrowserHost" Grid.Row="1"/></Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
