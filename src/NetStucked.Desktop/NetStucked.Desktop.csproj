<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ApplicationManifest>$(BaseIntermediateOutputPath)app.generated.manifest</ApplicationManifest><AssemblyName>NetStucked</AssemblyName>
    <ApplicationIcon>Resources/Brand/NetStucked.ico</ApplicationIcon>
    <Product>NetStucked</Product><Description>ICMP, TCP, DNS and network utilities for network engineers</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources/Brand/NetStuckedLogo.png" />
    <Resource Include="Resources/Brand/NetStucked.ico" />
    <EmbeddedResource Include="Resources/Icons/*.svg" LogicalName="NetStucked.Icons.%(Filename)%(Extension)" />
    <None Update="Resources/Icons/LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources/ThirdParty/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Resources/Terminal/**" />
    <Compile Remove="ViewModels/TerminalWorkspaceViewModel.cs;Views/TerminalView.xaml.cs" />
    <Page Remove="Views/TerminalView.xaml" />
    <EmbeddedResource Include="Resources/ReleaseHistory.json" LogicalName="NetStucked.ReleaseHistory.json" />
    <ProjectReference Include="../NetStucked.Core/NetStucked.Core.csproj" />
    <ProjectReference Include="../NetStucked.Infrastructure/NetStucked.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <Target Name="GenerateVersionedManifest" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <PropertyGroup><_AppManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/app.manifest').Replace('__ASSEMBLY_VERSION__', '$(AssemblyVersion)'))</_AppManifest></PropertyGroup>
    <WriteLinesToFile File="$(ApplicationManifest)" Lines="$(_AppManifest)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
  <Target Name="PrepareCollectorRuntime" BeforeTargets="AssignTargetPaths">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/Prepare-CollectorRuntime.ps1&quot;" />
    <ItemGroup>
      <_CollectorRuntime Include="$(MSBuildProjectDirectory)/../../artifacts/collector-runtime/payload/**/*" />
      <Content Include="@(_CollectorRuntime)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"><Link>CollectorRuntime/%(_CollectorRuntime.RecursiveDir)%(_CollectorRuntime.Filename)%(_CollectorRuntime.Extension)</Link></Content>
      <Content Include="$(MSBuildProjectDirectory)/../../src/NetStucked.Infrastructure/CollectorWorker/collector_worker.py" Link="CollectorRuntime/collector_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
